# Full public origin the server is reached at. Required in production.
# Used to build websocketUrl / viewerUrl — get it wrong and links point nowhere.
ONYX_PUBLIC_URL=https://onyx.example.com

PORT=3000
HOST=0.0.0.0

# file:./data/onyx.db by default
ONYX_DATABASE_URL=file:./data/onyx.db

# Required. >= 32 bytes, used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ONYX_SESSION_SECRET=

# Bootstrap the first admin non-interactively. Leave both unset to get a
# one-time setup token printed to stdout on first boot instead.
ONYX_ADMIN_EMAIL=
ONYX_ADMIN_PASSWORD=

ONYX_MAX_CONCURRENT_SESSIONS=5
ONYX_SESSION_IDLE_TIMEOUT_MS=300000
ONYX_SESSION_MAX_LIFETIME_MS=1800000

# Disables private-network egress denies. Leave false unless you know why
# you need it.
ONYX_ALLOW_PRIVATE_NETWORK=false

# Defaults to the Chromium playwright-core resolves for its pinned version.
ONYX_CHROME_EXECUTABLE_PATH=
